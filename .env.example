# ID de medição do Google Analytics 4 (formato G-XXXXXXXXXX).
# Deixe vazio ou remova para desligar o analytics — sem ele, nenhum script
# de rastreamento é carregado e a CSP permanece restrita à própria origem.
# Precisa estar definido no momento do BUILD (next build), não só em runtime.
NEXT_PUBLIC_GA_ID=

# Código de verificação do Google Search Console (opcional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
